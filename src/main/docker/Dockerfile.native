####
# This Dockerfile is used in order to build a container that runs the Quarkus application in native (no JVM) mode.
#
# Before building the container image run:
#
# ./gradlew build -Dquarkus.native.enabled=true
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.native -t quarkus/bots .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/bots
#
# The ` registry.access.redhat.com/ubi9/ubi-minimal:9.7` base image is based on UBI 9.
# To use UBI 8, switch to `quay.io/ubi8/ubi-minimal:8.10`.
###
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 build/*-runner /work/application
COPY --chown=1001:root --chmod=0755 src/main/docker/healthcheck.sh /work/healthcheck.sh

USER 1001

# ubi-minimal ships curl, so the ECS health check can be the same as the data service's:
#   curl -f http://localhost:8080/q/health/live || exit 1
# HTTP listens on 127.0.0.1 only; curl falls back from ::1 to 127.0.0.1 for "localhost". /work/healthcheck.sh is
# the curl-free alternative (also in the micro image).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD curl -fs http://127.0.0.1:8080/q/health/live || exit 1
ENTRYPOINT ["./application"]
